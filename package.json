{
  "name": "react-gitblog-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run author:check && npm run build:site && npm run images:optimize && node scripts/build-cname.mjs && npm run hub:validate && npm run discovery:check && npm run search:index",
    "preview": "node ./scripts/preview.mjs",
    "check": "npm run test:deployment && npm run test:harness && npm run author:check && npm run posts:ids:check && npm run taxonomy:check && npm run check:site",
    "posts:ids:check": "node ./scripts/post-ids.mjs --check",
    "posts:new": "tsx scripts/new-post.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:template": "npm run test:integration",
    "update:check": "node ./scripts/validate-update.mjs",
    "test:browser": "tsx scripts/browser-check.ts",
    "posts:ids": "node ./scripts/post-ids.mjs --write",
    "hub:validate": "node ./scripts/validate-hub-contract.mjs",
    "translate:content": "node ./scripts/sync-content.mjs",
    "content:prepare": "node ./scripts/sync-content.mjs --prepare",
    "author:context": "node ./scripts/authoring.mjs context",
    "author:new": "node ./scripts/authoring.mjs new",
    "author:status": "node ./scripts/authoring.mjs status",
    "author:translation": "node ./scripts/authoring.mjs translation",
    "author:check": "node ./scripts/authoring.mjs check",
    "author:verify": "node ./scripts/authoring.mjs verify",
    "author:deploy": "node ./scripts/authoring.mjs deploy",
    "author:deploy-status": "node ./scripts/authoring.mjs deploy-status",
    "translate:posts": "npm run translate:content",
    "site:setup": "node ./scripts/setup.mjs inspect",
    "site:configure": "node ./scripts/setup.mjs apply",
    "site:check": "node ./scripts/setup.mjs check",
    "site:pages": "node ./scripts/setup.mjs pages",
    "site:pages:status": "node ./scripts/setup.mjs pages-status",
    "discovery:check": "node ./scripts/audit-discovery.mjs",
    "taxonomy:sync": "node ./scripts/taxonomy.mjs",
    "taxonomy:check": "node ./scripts/taxonomy.mjs --check",
    "site:app:status": "node ./scripts/setup.mjs app-status",
    "build:site": "tsx scripts/build.tsx",
    "check:site": "tsc --noEmit && npm test",
    "test:seo": "tsx scripts/verify-template.ts --seo",
    "test:integration": "tsx scripts/verify-template.ts",
    "test:authoring:build": "npm run test:integration",
    "test:harness": "node --test tests/test-*.mjs tests/test-*.ts",
    "test:harness-docs": "node tests/test-harness-docs.mjs",
    "search:index": "node scripts/build-search.mjs",
    "test:deployment": "node ./tests/test-deployment.mjs && node --test tests/test-pages-domains.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "test:tts": "node tests/test-tts-translations.mjs && python3 -m unittest discover -s tests/tts -v",
    "test:memberships": "node tests/test-memberships.mjs",
    "test:images": "node --test tests/test-images.mjs",
    "distribution:export": "node scripts/distribution/export.mjs",
    "test:distribution": "node --test tests/test-distribution.mjs",
    "release:check": "npm run check && npm run test:integration && npm run test:tts && npm run test:memberships && npm run test:browser",
    "test:deepl": "node ./tests/test-deepl-posts.mjs"
  },
  "dependencies": {
    "@gitblogapp/browser": "0.1.1",
    "@gitblogapp/cli": "0.1.1",
    "@gitblogapp/core": "0.1.1",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "js-yaml": "4.3.2",
    "marked": "^18.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "fast-xml-parser": "^5.11.2",
    "fast-xml-validator": "^1.4.2",
    "pagefind": "^1.5.0",
    "prettier": "^3.9.9",
    "robots-parser": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "overrides": {
    "js-yaml@4.1.1": "4.3.2",
    "gray-matter": {
      "js-yaml": "3.15.2"
    }
  }
}
