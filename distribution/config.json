{
  "schemaVersion": 1,
  "repository": "gitblogapp/react-gitblog-template",
  "developmentRepository": "gitblogapp/react-gitblog-template-dev",
  "minimumVersion": "1.0.0",
  "files": [
    ".env.example",
    ".env.production",
    ".gitignore",
    ".pages.yml",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "directories": [
    "src",
    "static",
    "content",
    "docs/gitblog",
    "scripts",
    "vendor/gitblog-packages"
  ],
  "metadata": [
    ".gitblog/authoring.json",
    ".gitblog/update-policy.json",
    ".gitblog/user-instructions.md",
    ".gitblog/template-standard.json"
  ],
  "workflows": [
    "deploy.yml",
    "hub-discussion-comment.yml",
    "post-history.yml",
    "sync-hub.yml"
  ],
  "omitDependencies": [
    "@playwright/test",
    "fast-xml-parser",
    "fast-xml-validator",
    "prettier",
    "prettier-plugin-astro",
    "robots-parser"
  ],
  "excludeFiles": [
    "scripts/browser-check.ts",
    "scripts/verify-template.ts",
    "scripts/verify-reference.ts",
    "scripts/preservation.ts"
  ],
  "scripts": {
    "check": "npm run author:check && npm run posts:ids:check && npm run taxonomy:check && npm run check:site",
    "check:site": "tsc --noEmit"
  },
  "releaseChannel": "stable"
}
